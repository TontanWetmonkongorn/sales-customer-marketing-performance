            "dataType": "string",
            "lineageTag": "1e5170d6-a46e-4d26-af30-26388a4b5069",
            "sourceColumn": "coverage",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "41e04056-9ccc-4aaf-b743-27e15ffee9bc",
        "measures": [
          {
            "name": "Reported Order Value",
            "expression": "SUM(Orders[order_total])",
            "formatString": "#,##0.00",
            "lineageTag": "1745dfe2-c097-495e-837f-fc6dd2bc09a7"
          },
          {
            "name": "Order Count",
            "expression": "COUNTROWS(Orders)",
            "formatString": "#,##0",
            "lineageTag": "88578752-9d05-48de-afdd-8bda98256859"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Reported Order Value], [Order Count])",
            "formatString": "#,##0.00",
            "lineageTag": "7b17ae86-2c0d-41cd-b1ab-cfbe73d1cea5"
          },
          {
            "name": "Full Month Order Value",
            "expression": "CALCULATE([Reported Order Value], KEEPFILTERS(Orders[coverage] = \"Within coverage\"))",
            "formatString": "#,##0.00",
            "lineageTag": "42482861-524c-4e72-a191-6235fc54ab50"
          },
          {
            "name": "Latest Full Month Growth",
            "expression": "VAR ThisMonth = CALCULATE([Reported Order Value], REMOVEFILTERS(Calendar), Orders[month] = \"2024-10\") VAR PriorMonth = CALCULATE([Reported Order Value], REMOVEFILTERS(Calendar), Orders[month] = \"2024-09\") RETURN DIVIDE(ThisMonth - PriorMonth, PriorMonth)",
            "formatString": "0.00%",
            "lineageTag": "55b0716a-ce4e-4010-9461-3de3ac12a06e"
          },
          {
            "name": "Segment Order Value",
            "expression": "[Reported Order Value]",
            "formatString": "#,##0.00",
            "lineageTag": "97275cab-3f3d-4703-a8b0-de0573191f95"
          },
          {
            "name": "Purchasing Customers",
            "expression": "DISTINCTCOUNT(Orders[customer_id])",
            "formatString": "#,##0",
            "lineageTag": "e94877f7-166b-4835-ad1f-aa733f8258d2"
          },
          {
            "name": "Repeat Purchasers",
            "expression": "COUNTROWS(FILTER(VALUES(Orders[customer_id]), CALCULATE([Order Count]) >= 2))",
            "formatString": "#,##0",
            "lineageTag": "984a23cf-3ca3-4713-89f4-966ae30c0475"
          },
          {
            "name": "Repeat Purchaser Rate",
            "expression": "DIVIDE([Repeat Purchasers], [Purchasing Customers])",
            "formatString": "0.00%",
            "lineageTag": "8cec89b4-b609-4650-9bf3-27f769d55d28"
          },
          {
            "name": "Purchase Participation",
            "expression": "DIVIDE([Purchasing Customers], COUNTROWS(Customers))",
            "formatString": "0.00%",
            "lineageTag": "8fcea013-c181-4d73-afed-68a1e4a2334d"
          }
        ],
