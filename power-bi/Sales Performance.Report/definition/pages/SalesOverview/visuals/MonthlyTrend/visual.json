                  "Property": "month"
                }
              },
              "queryRef": "MonthlySales.month",
              "nativeQueryRef": "month",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "MonthlySales"
                    }
                  },
                  "Property": "Reported Order Value"
                }
              },
              "queryRef": "MonthlySales.Reported Order Value",
              "nativeQueryRef": "Reported Order Value",
              "active": true
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly order value | Mar 2023 and Nov 2024 partial'"
                }
              }
            }
          }
        }
