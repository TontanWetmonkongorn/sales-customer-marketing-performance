// Add each measure individually in Power BI Desktop.
Reported Order Value = SUM(MonthlySales[reported_order_value])

Orders = SUM(MonthlySales[orders])

Average Order Value = DIVIDE([Reported Order Value], [Orders])

Repeat Purchaser Rate =
    DIVIDE(SUM(CustomerSegments[repeat_purchasers]), SUM(CustomerSegments[purchasing_customers]))

Supplied Item Value = SUM(ProductCategories[supplied_item_value])

Campaign Spend = SUM(CampaignPerformance[spend])

Campaign Revenue = SUM(CampaignPerformance[reported_campaign_revenue])

Campaign ROAS = DIVIDE([Campaign Revenue], [Campaign Spend])

Click-Through Rate =
    DIVIDE(SUM(CampaignPerformance[clicks]), SUM(CampaignPerformance[impressions]))

Click-to-Conversion Rate =
    DIVIDE(SUM(CampaignPerformance[conversions]), SUM(CampaignPerformance[clicks]))
