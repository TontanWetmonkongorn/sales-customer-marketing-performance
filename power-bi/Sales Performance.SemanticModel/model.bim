{
  "name": "Sales Performance",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "MonthlySales",
        "columns": [
          {
            "name": "month",
            "sourceColumn": "month",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "orders",
            "sourceColumn": "orders",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "reported_order_value",
            "sourceColumn": "reported_order_value",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "average_order_value",
            "sourceColumn": "average_order_value",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "coverage",
            "sourceColumn": "coverage",
            "dataType": "string",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Reported Order Value",
            "expression": "SUM(MonthlySales[reported_order_value])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Order Count",
            "expression": "SUM(MonthlySales[orders])",
            "formatString": "#,##0"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Reported Order Value], [Order Count])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Full Month Order Value",
            "expression": "CALCULATE([Reported Order Value], KEEPFILTERS(MonthlySales[coverage] = \"Within coverage\"))",
            "formatString": "#,##0.00"
          },
          {
            "name": "Latest Full Month Growth",
            "expression": "\nVAR FullMonths = FILTER(ALL(MonthlySales), MonthlySales[coverage] = \"Within coverage\")\nVAR Latest = MAXX(FullMonths, MonthlySales[month])\nVAR Prior = MAXX(FILTER(FullMonths, MonthlySales[month] < Latest), MonthlySales[month])\nVAR CurrentValue = SUMX(FILTER(FullMonths, MonthlySales[month] = Latest), MonthlySales[reported_order_value])\nVAR PriorValue = SUMX(FILTER(FullMonths, MonthlySales[month] = Prior), MonthlySales[reported_order_value])\nRETURN DIVIDE(CurrentValue - PriorValue, PriorValue)",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "MonthlySales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "#table(type table [month = text, orders = number, reported_order_value = number, average_order_value = number, coverage = text], {",
                "    {\"2023-03\", 120, 272878.96, 2273.99, \"Partial\"},",
                "    {\"2023-04\", 238, 554344.77, 2329.18, \"Within coverage\"},",
                "    {\"2023-05\", 276, 608213.54, 2203.67, \"Within coverage\"},",
                "    {\"2023-06\", 232, 505227.66, 2177.71, \"Within coverage\"},",
                "    {\"2023-07\", 244, 567639.91, 2326.39, \"Within coverage\"},",
                "    {\"2023-08\", 285, 623472.35, 2187.62, \"Within coverage\"},",
                "    {\"2023-09\", 262, 571117.81, 2179.84, \"Within coverage\"},",
                "    {\"2023-10\", 254, 578369.83, 2277.05, \"Within coverage\"},",
                "    {\"2023-11\", 265, 567783.74, 2142.58, \"Within coverage\"},",
                "    {\"2023-12\", 268, 615709.03, 2297.42, \"Within coverage\"},",
                "    {\"2024-01\", 270, 560423.56, 2075.64, \"Within coverage\"},",
                "    {\"2024-02\", 252, 545090.11, 2163.06, \"Within coverage\"},",
                "    {\"2024-03\", 251, 543181.85, 2164.07, \"Within coverage\"},",
                "    {\"2024-04\", 241, 538754.75, 2235.5, \"Within coverage\"},",
                "    {\"2024-05\", 263, 574163.61, 2183.13, \"Within coverage\"},",
                "    {\"2024-06\", 248, 539074.85, 2173.69, \"Within coverage\"},",
                "    {\"2024-07\", 256, 573111.98, 2238.72, \"Within coverage\"},",
                "    {\"2024-08\", 251, 546194.57, 2176.07, \"Within coverage\"},",
                "    {\"2024-09\", 247, 518695.03, 2099.98, \"Within coverage\"},",
                "    {\"2024-10\", 247, 537702.94, 2176.93, \"Within coverage\"},",
                "    {\"2024-11\", 30, 68157.65, 2271.92, \"Partial\"}",
                "})"
              ]
            }
          }
        ]
      },
      {
        "name": "CustomerSegments",
        "columns": [
          {
            "name": "customer_segment",
            "sourceColumn": "customer_segment",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "registered_customers",
            "sourceColumn": "registered_customers",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "purchasing_customers",
            "sourceColumn": "purchasing_customers",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "repeat_purchasers",
            "sourceColumn": "repeat_purchasers",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "repeat_pct_of_purchasers",
            "sourceColumn": "repeat_pct_of_purchasers",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "reported_order_value",
            "sourceColumn": "reported_order_value",
            "dataType": "double",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Repeat Purchaser Rate",
            "expression": "DIVIDE(SUM(CustomerSegments[repeat_purchasers]), SUM(CustomerSegments[purchasing_customers]))",
            "formatString": "0.00%"
          },
          {
            "name": "Purchasing Customers",
            "expression": "SUM(CustomerSegments[purchasing_customers])",
            "formatString": "#,##0"
          },
          {
            "name": "Repeat Purchasers",
            "expression": "SUM(CustomerSegments[repeat_purchasers])",
            "formatString": "#,##0"
          },
          {
            "name": "Segment Order Value",
            "expression": "SUM(CustomerSegments[reported_order_value])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Purchase Participation",
            "expression": "DIVIDE([Purchasing Customers], SUM(CustomerSegments[registered_customers]))",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "CustomerSegments",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "#table(type table [customer_segment = text, registered_customers = number, purchasing_customers = number, repeat_purchasers = number, repeat_pct_of_purchasers = number, reported_order_value = number], {",
                "    {\"Regular\", 639, 574, 400, 69.69, 2890148.66},",
                "    {\"New\", 628, 530, 361, 68.11, 2795854.48},",
                "    {\"Premium\", 633, 550, 381, 69.27, 2731329.71},",
                "    {\"Inactive\", 600, 518, 350, 67.57, 2591975.65}",
                "})"
              ]
            }
          }
        ]
      },
      {
        "name": "ProductCategories",
        "columns": [
          {
            "name": "category",
            "sourceColumn": "category",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "supplied_units",
