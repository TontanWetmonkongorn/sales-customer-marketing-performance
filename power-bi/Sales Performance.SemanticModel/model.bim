            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "reported_campaign_revenue",
            "sourceColumn": "reported_campaign_revenue",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "ctr_pct",
            "sourceColumn": "ctr_pct",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "click_conversion_pct",
            "sourceColumn": "click_conversion_pct",
            "dataType": "double",
            "summarizeBy": "none"
          },
          {
            "name": "recalculated_roas",
            "sourceColumn": "recalculated_roas",
            "dataType": "double",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Campaign Spend",
            "expression": "SUM(CampaignPerformance[spend])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Campaign Revenue",
            "expression": "SUM(CampaignPerformance[reported_campaign_revenue])",
            "formatString": "#,##0.00"
          },
          {
            "name": "Campaign ROAS",
            "expression": "DIVIDE([Campaign Revenue], [Campaign Spend])",
            "formatString": "0.00\"×\""
          },
          {
            "name": "Cost per Conversion",
            "expression": "DIVIDE([Campaign Spend], SUM(CampaignPerformance[conversions]))",
            "formatString": "#,##0.00"
          },
          {
            "name": "Campaign Conversions",
            "expression": "SUM(CampaignPerformance[conversions])",
            "formatString": "#,##0"
          },
          {
            "name": "Click-Through Rate",
            "expression": "DIVIDE(SUM(CampaignPerformance[clicks]), SUM(CampaignPerformance[impressions]))",
            "formatString": "0.00%"
          },
          {
            "name": "Click-to-Conversion Rate",
            "expression": "DIVIDE(SUM(CampaignPerformance[conversions]), SUM(CampaignPerformance[clicks]))",
            "formatString": "0.00%"
          }
        ],
