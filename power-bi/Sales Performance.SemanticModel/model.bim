            "summarizeBy": "none"
          },
          {
            "name": "supplied_item_value",
            "sourceColumn": "supplied_item_value",
            "dataType": "double",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Supplied Item Value",
            "expression": "SUM(ProductCategories[supplied_item_value])",
            "formatString": "#,##0.00"
          }
        ],
        "partitions": [
          {
            "name": "ProductCategories",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "#table(type table [category = text, supplied_units = number, supplied_item_value = number], {",
                "    {\"Dairy & Breakfast\", 1114, 639222.19},",
                "    {\"Pharmacy\", 973, 592368.57},",
                "    {\"Fruits & Vegetables\", 966, 559053.08},",
                "    {\"Pet Care\", 1003, 539888.75},",
                "    {\"Household Care\", 1078, 444244.25},",
                "    {\"Personal Care\", 887, 394894.61},",
                "    {\"Snacks & Munchies\", 963, 394648.71},",
                "    {\"Cold Drinks & Juices\", 758, 392717.62},",
                "    {\"Grocery & Staples\", 895, 359937.82},",
                "    {\"Baby Care\", 655, 348227.18},",
                "    {\"Instant & Frozen Food\", 742, 307212.65}",
                "})"
              ]
            }
          }
        ]
      },
      {
        "name": "CampaignPerformance",
        "columns": [
          {
            "name": "channel",
